# Google Gemini API key. Without this the backend runs in mock mode.
GOOGLE_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to local Vite dev origins if unset.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Port the Flask dev server listens on (gunicorn ignores this in production).
PORT=5000

# Set to "true" to enable Flask's debug/reloader for local development only.
# Never enable in production — it exposes the interactive debugger (RCE risk).
FLASK_DEBUG=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Gemini request tuning
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1024

# Chat input limits
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_TURNS=10
